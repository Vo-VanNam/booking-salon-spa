# Copy to .env and fill in. NEVER commit real secrets (.env is gitignored).
# run.sh generates the local database password + JWT secret on first run if .env is missing.

# ── Infrastructure (local/dev) ────────────────────────────────────────────────
POSTGRES_USER=booking
POSTGRES_PASSWORD=
POSTGRES_DB=booking
POSTGRES_PORT=55432
REDIS_PORT=56379
# DATABASE_URL=postgresql://booking:<password>@127.0.0.1:55432/booking?schema=public
# REDIS_URL=redis://127.0.0.1:56379

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=8100
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGINS=http://localhost:8101
SLOT_STEP_MINUTES=15
SLOT_CACHE_TTL_SECONDS=30
# Bật khi chạy sau reverse proxy (nginx ghi X-Real-IP = $remote_addr); để false khi truy cập trực tiếp.
TRUST_PROXY=false
LOYALTY_THRESHOLD=10
LOYALTY_DISCOUNT_PERCENT=10
REMINDER_HOURS=24,1

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8100

# ── Payments (may be absent; creation then fails with a Vietnamese error) ─────
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=

# ── AI assistant (may be absent; /ai/chat then returns a Vietnamese error) ────
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000

# ── Notifications (optional) ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
