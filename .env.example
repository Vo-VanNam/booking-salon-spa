# ===== Biến môi trường dev (KHÔNG chứa secret thật — chỉ dùng cho môi trường phát triển local) =====

# Chuỗi kết nối PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
# Dùng chung cho Prisma CLI, migrations và runtime backend. Khớp với docker-compose.dev.yml (POSTGRES_USER=salon, POSTGRES_PASSWORD=salon_dev_password, POSTGRES_DB=salon_spa).
DATABASE_URL=postgresql://salon:salon_dev_password@localhost:5432/salon_spa?schema=public

# Chuỗi kết nối Redis: redis://<host>:<port>
# Dùng cho cache slot trống và hàng đợi BullMQ (nhắc lịch). Khớp với service redis trong docker-compose.dev.yml.
REDIS_URL=redis://localhost:6379
