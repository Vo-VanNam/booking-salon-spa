// Data model for the salon/spa booking chain — see docs/DATA_MODEL.md and DOCUMENT.md §3.
// Conventions: snake_case tables/columns, all instants stored as UTC (timestamptz),
// money as integer VND, Asia/Ho_Chi_Minh conversions only in the application layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  stylist
  branch_admin
  super_admin
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum DepositStatus {
  unpaid
  pending
  paid
  refunded
}

enum PaymentProvider {
  vnpay
  momo
}

enum PaymentStatus {
  pending
  success
  failed
}

enum LoyaltyType {
  earn
  redeem
  adjust
}

enum NotificationChannel {
  email
  sms
}

enum NotificationStatus {
  queued
  sent
  failed
  skipped
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String
  openTime  String   @default("08:00") @map("open_time") // HH:mm, Asia/Ho_Chi_Minh
  closeTime String   @default("20:00") @map("close_time")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  services Service[]
  stylists Stylist[]
  bookings Booking[]
  users    User[]

  @@map("branches")
}

model Service {
  id              String   @id @default(cuid())
  branchId        String   @map("branch_id")
  name            String
  description     String?
  price           Int
  durationMinutes Int      @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([branchId, isActive])
  @@map("services")
}

model Stylist {
  id        String   @id @default(cuid())
  branchId  String   @map("branch_id")
  name      String
  phone     String?
  email     String?
  bio       String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  workingHours WorkingHour[]
  timeOff      TimeOff[]
  bookings     Booking[]
  users        User[]

  @@index([branchId, isActive])
  @@map("stylists")
}

model WorkingHour {
  id         String   @id @default(cuid())
  stylistId  String   @map("stylist_id")
  dayOfWeek  Int      @map("day_of_week") // 0 = Chủ nhật … 6 = Thứ bảy
  startTime  String   @map("start_time") // HH:mm local
  endTime    String   @map("end_time")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@unique([stylistId, dayOfWeek, startTime])
  @@index([stylistId, dayOfWeek])
  @@map("working_hours")
}

model TimeOff {
  id        String   @id @default(cuid())
  stylistId String   @map("stylist_id")
  startTime DateTime @map("start_time") @db.Timestamptz(3)
  endTime   DateTime @map("end_time") @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@index([stylistId, startTime, endTime])
  @@map("time_off")
}

model Customer {
  id                     String   @id @default(cuid())
  name                   String
  phone                  String   @unique
  email                  String?
  completedBookings      Int      @default(0) @map("completed_bookings")
  /// Số lần đặt hoàn thành tại thời điểm ưu đãi loyalty được dùng gần nhất (chống dùng trùng).
  loyaltyDiscountUsedAt  Int?     @map("loyalty_discount_used_at")
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings             Booking[]
  loyaltyTransactions  LoyaltyTransaction[]
  users                User[]

  @@index([phone])
  @@map("customers")
}

model Booking {
  id              String        @id @default(cuid())
  branchId        String        @map("branch_id")
  serviceId       String        @map("service_id")
  stylistId       String        @map("stylist_id")
  customerId      String        @map("customer_id")
  startTime       DateTime      @map("start_time") @db.Timestamptz(3)
  endTime         DateTime      @map("end_time") @db.Timestamptz(3)
  status          BookingStatus @default(confirmed)
  price           Int
  discountAmount  Int           @default(0) @map("discount_amount")
  depositAmount   Int           @default(0) @map("deposit_amount")
  depositStatus   DepositStatus @default(unpaid) @map("deposit_status")
  note            String?
  source          String        @default("web") // web | ai | admin | phone
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  stylist  Stylist   @relation(fields: [stylistId], references: [id], onDelete: Restrict)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  payments            PaymentTransaction[]
  loyaltyTransactions LoyaltyTransaction[]
  notifications       Notification[]

  // Index bắt buộc (DOCUMENT.md §3): tra cứu trùng lịch theo stylist và lịch theo chi nhánh.
  @@index([stylistId, startTime, endTime])
  @@index([branchId, startTime])
  @@index([status, startTime])
  @@index([customerId, status])
  @@map("bookings")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  fullName     String   @map("full_name")
  branchId     String?  @map("branch_id")
  stylistId    String?  @map("stylist_id")
  customerId   String?  @map("customer_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stylist      Stylist?      @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model LoyaltyTransaction {
  id             String      @id @default(cuid())
  customerId     String      @map("customer_id")
  bookingId      String?     @map("booking_id")
  type           LoyaltyType
  points         Int         @default(0)
  discountAmount Int         @default(0) @map("discount_amount")
  description    String
  actor          String?     // ai | system | <user id>
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([bookingId])
  @@map("loyalty_transactions")
}

model PaymentTransaction {
  id             String          @id @default(cuid())
  bookingId      String          @map("booking_id")
  provider       PaymentProvider
  txnRef         String          @map("txn_ref")
  amount         Int
  status         PaymentStatus   @default(pending)
  rawPayload     Json?           @map("raw_payload")
  signatureValid Boolean?        @map("signature_valid")
  message        String?
  processedAt    DateTime?       @map("processed_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // One row per gateway reference → "credit exactly once" holds even for concurrent duplicate webhooks.
  @@unique([provider, txnRef])
  @@index([bookingId])
  @@map("payment_transactions")
}

model AiSession {
  sessionId String   @id @map("session_id")
  /// null = khách tự dùng; ngược lại là user id của staff (trợ lý phân tích 2.9)
  userId    String?  @map("user_id")
  kind      String   @default("customer")
  needsHuman Boolean @default(false) @map("needs_human")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_sessions")
}

model AiToolCall {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  toolName      String   @map("tool_name")
  arguments     Json?
  resultPreview String?  @map("result_preview")
  success       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([sessionId, createdAt])
  @@map("ai_tool_calls")
}

model Notification {
  id        String             @id @default(cuid())
  bookingId String?            @map("booking_id")
  channel   NotificationChannel
  kind      String             // reminder-24h | reminder-1h | booking-confirmed | ...
  to        String
  status    NotificationStatus @default(queued)
  payload   Json?
  error     String?
  sentAt    DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId, kind])
  @@map("notifications")
}
