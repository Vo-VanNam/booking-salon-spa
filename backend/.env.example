# Môi trường chạy: development | test | production
NODE_ENV=development
# Cổng HTTP của backend
PORT=3001
# Kết nối PostgreSQL (Prisma)
DATABASE_URL=postgresql://salon:salon_dev_password@localhost:5432/salon_spa?schema=public
# Kết nối Redis
REDIS_URL=redis://localhost:6379
# Origin được phép gọi API (frontend)
CORS_ORIGIN=http://localhost:3000
# Secret ký access token (tối thiểu 32 ký tự) — tạo bằng: openssl rand -hex 32
JWT_ACCESS_SECRET=thay-bang-secret-64-ky-tu
# Thời gian sống access token (giây)
JWT_ACCESS_TTL=900
# Secret ký refresh token (tối thiểu 32 ký tự, khác access secret) — tạo bằng: openssl rand -hex 32
JWT_REFRESH_SECRET=thay-bang-secret-64-ky-tu
# Rate limit toàn cục: cửa sổ thời gian (ms)
THROTTLE_TTL=60000
# Rate limit toàn cục: số request tối đa trong cửa sổ
THROTTLE_LIMIT=100

# Tai khoan super_admin duoc seed (dev-only)
SEED_ADMIN_EMAIL=admin@salonglow.vn
# Mat khau seed DEV-ONLY - bat buoc doi truoc khi deploy
SEED_ADMIN_PASSWORD=SalonAdmin@2026

# ===== Thanh toan truc tuyen (VNPay + MoMo) =====
# Bat/tat tinh nang thanh toan truc tuyen. false la hop le (chua co key),
# khi do POST /api/bookings/:id/deposit tra 503 kem message tieng Viet.
PAYMENT_ENABLED=false
# Phan tram coc mac dinh tren tong tien booking (30 = 30%)
DEPOSIT_PERCENT=30
# VNPay - thay bang key cua merchant (sandbox: https://sandbox.vnpayment.vn)
VNP_TMN_CODE=thay-bang-tmn-code
VNP_HASH_SECRET=thay-bang-vnp-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3001/api/payments/vnpay/return
VNP_IPN_URL=http://localhost:3001/api/payments/vnpay/ipn
# MoMo - thay bang key cua merchant (sandbox: https://developers.momo.vn)
MOMO_PARTNER_CODE=thay-bang-partner-code
MOMO_ACCESS_KEY=thay-bang-access-key
MOMO_SECRET_KEY=thay-bang-secret-key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3001/api/payments/momo/return
MOMO_IPN_URL=http://localhost:3001/api/payments/momo/ipn

# ===== Nhap lich (email + SMS) =====
# SMTP cho gui email nhac lich (bo trong -> chi log, khong gui that)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=salon@example.vn
# SMS: thieu SMS_API_URL -> LogSmsProvider (chi log JSON co tag [SMS]).
# Co SMS_API_URL -> gui HTTP POST {phone, message} kem header x-api-key.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Salon
