# ============================================================
# .env.production — môi trường PRODUCTION (KHÔNG được commit secret thật)
# ============================================================
# Cách dùng:
#   cp .env.production.example .env.production
#   # sửa toàn bộ chỗ CHANGE_ME / thay-... rồi chạy:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# Tất cả giá trị dưới đây là PLACEHOLDER — bắt buộc thay trước khi deploy.

# ===== PostgreSQL (dùng chung cho service postgres và backend) =====
# Mật khẩu của database (service postgres trong compose đọc biến này).
# PHẢI khớp với password trong DATABASE_URL bên dưới.
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# Chuỗi kết nối PostgreSQL. Host "postgres" = tên service trong compose.
DATABASE_URL=postgresql://salon:CHANGE_ME_postgres_password@postgres:5432/salon_spa?schema=public

# ===== Redis (cache slot + BullMQ nhắc lịch) — host "redis" = tên service =====
REDIS_URL=redis://redis:6379

# ===== Ứng dụng =====
# production | development | test
NODE_ENV=production
# Cổng HTTP của backend (bên trong container, không publish ra host)
PORT=3001
# Origin được phép gọi API — đổi thành domain thật của bạn, VD: https://salon-glow.example.com
CORS_ORIGIN=https://your-domain.example.com

# ===== JWT =====
# Tạo secret mạnh: openssl rand -hex 32 (tối thiểu 32 ký tự, 2 secret khác nhau)
JWT_ACCESS_SECRET=thay-bang-openssl-rand-hex-32-cho-access-token
# Thời gian sống access token (giây)
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=thay-bang-openssl-rand-hex-32-cho-refresh-token

# ===== Rate limit =====
# Cửa sổ thời gian (ms) và số request tối đa trong cửa sổ (global)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ===== Tài khoản super_admin seed (chỉ chạy khi seed thủ công lần đầu) =====
SEED_ADMIN_EMAIL=admin@your-domain.example.com
# BẮT BUỘC ĐỔI NGAY KHI DEPLOY — mật khẩu mạnh >= 12 ký tự
SEED_ADMIN_PASSWORD=ĐỔI-NGAY-KHI-DEPLOY-2026

# ===== Thanh toán trực tuyến (VNPay + MoMo) =====
# false là hợp lệ (chưa có key) — endpoint deposit trả 503 message tiếng Việt.
PAYMENT_ENABLED=false
# Phần trăm đặt cọc trên tổng tiền booking (30 = 30%)
DEPOSIT_PERCENT=30
# VNPay — thay bằng key merchant thật (sandbox: https://sandbox.vnpayment.vn)
VNP_TMN_CODE=thay-bang-vnp-tmn-code
VNP_HASH_SECRET=thay-bang-vnp-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://your-domain.example.com/api/payments/vnpay/return
VNP_IPN_URL=https://your-domain.example.com/api/payments/vnpay/ipn
# MoMo — thay bằng key merchant thật (https://developers.momo.vn)
MOMO_PARTNER_CODE=thay-bang-momo-partner-code
MOMO_ACCESS_KEY=thay-bang-momo-access-key
MOMO_SECRET_KEY=thay-bang-momo-secret-key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://your-domain.example.com/api/payments/momo/return
MOMO_IPN_URL=https://your-domain.example.com/api/payments/momo/ipn

# ===== Nhắc lịch (email + SMS) =====
# SMTP gửi email nhắc lịch (để trống → chỉ log, không gửi thật)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=salon@your-domain.example.com
# SMS: thiếu SMS_API_URL → LogSmsProvider (chỉ log). Có URL → HTTP POST {phone, message} kèm header x-api-key.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Salon
